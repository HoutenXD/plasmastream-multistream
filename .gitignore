# Downloaded by CMake during configure: OBS sources, obs-deps and Qt6, plus the
# libobs build they produce. Hundreds of megabytes, entirely reproducible from
# buildspec.json, and never committed.
.deps/

# Build trees, one per platform preset.
build_*/

# Bumped by every local build, so tracking it puts a one-line diff in unrelated
# commits. Each machine keeps its own count.
cmake/.CMakeBuildNumber
